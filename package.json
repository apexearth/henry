{
  "name": "henry",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "test": "bun run --filter @henry/daemon test",
    "build": "bun run --filter '*' build",
    "start": "bun run --cwd packages/daemon start",
    "app": "bun run --cwd packages/shell dev",
    "app:bundle": "bun run --cwd packages/shell bundle",
    "typecheck": "bun run --filter '*' typecheck",
    "smoke": "bun run --cwd packages/daemon smoke",
    "sessiond": "bun run --cwd packages/sessiond start"
  },
  "trustedDependencies": [
    "node-pty"
  ],
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
