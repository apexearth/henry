{
  "name": "@henry/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "bin": {
    "henry": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts start",
    "start": "bun src/index.ts start",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "smoke": "bun test/smoke.ts",
    "test": "bun test/run-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@henry/shared": "workspace:*",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0"
  }
}
